# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Streaming presence URL (optional but recommended).
# Must be a full http(s) URL, e.g. a Twitch or YouTube live channel.
# The bot shows: Streaming "Bot convert by KEJU".
STREAMING_URL=https://www.twitch.tv/your_channel

# Extra user IDs allowed to manage global cookies (comma-separated, optional).
COOKIE_ADMIN_IDS=
